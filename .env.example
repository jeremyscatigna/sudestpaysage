# =============================================================================
#  Sud Est Paysage — variables d'environnement
# =============================================================================
#  Copier ce fichier en `.env.local` (ignoré par Git) et renseigner les valeurs.
#  Les mêmes variables doivent être déclarées sur Vercel
#  (Project Settings > Environment Variables) pour Production ET Preview.
# =============================================================================

# --- Resend (envoi des e-mails de devis) -------------------------------------

# Clé API Resend. Secret : ne jamais la commiter ni la préfixer NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Expéditeur des e-mails, au format « Nom (adresse) ».
#
# ATTENTION : le domaine utilisé ici DOIT être vérifié dans le compte Resend.
# À ce jour, seul `magnet.wtf` l'est ; `sudestpaysage.fr` ne l'est pas encore.
# L'expéditeur est entièrement piloté par cette variable : dès que le domaine
# définitif sera vérifié chez Resend, il suffira de changer cette seule ligne
# (ici et sur Vercel) — aucune modification de code n'est nécessaire.
RESEND_FROM="Sud Est Paysage <devis@magnet.wtf>"

# Boîte qui reçoit les demandes de devis.
DEVIS_TO_EMAIL=sud-estpaysage@outlook.fr

# --- Confidentialité ---------------------------------------------------------

# Sel de hachage des adresses IP (optionnel mais recommandé).
# Les IP ne sont jamais stockées en clair : seulement SHA-256(sel + IP).
# Générer avec : openssl rand -hex 32
IP_HASH_SALT=

# --- Site --------------------------------------------------------------------

# URL canonique, sans slash final (métadonnées, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.sudestpaysage.fr

# --- Supabase (archivage des demandes, best effort) --------------------------

# La persistance en base est volontairement facultative : si Supabase est
# indisponible ou si la table `devis` n'existe pas encore, la demande est
# malgré tout envoyée par e-mail. Jouer `supabase/migrations/0001_devis.sql`
# dans l'éditeur SQL Supabase pour créer la table.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
